# Copy this file to .env and fill in the blanks. .env is gitignored.

OPENROUTER_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=

# Directory that contains data/{model}/...
NPJ_PROJECT_ROOT=

# Biomedical entity lexicon. One entity per line; the text before @@ is used.
NPJ_ENTITY_DICT=

# Hugging Face model id, or a local tokenizer directory.
NPJ_TOKENIZER=

# Optional. Used for token semantic similarity.
NPJ_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
